	}}
\newcommand{\rnnTaittiriyapratisakhya}[2]{%
	Tai\-tti\-rī\-ya\-prā\-ti\-śā\-khya%
	\index{Taittiriyapratisakhya@Taittirīyaprātiśākhya!#1@\emph{#2}%
	}}

% #1: the one you want to type, full version
% #2: the one you want to show up in the typeset version, full
% #3: the one you want to type, abbreviated
% #4: the one you want to show up in the typeset version, abbreviated
% #5: index sort key
% #6: how you want it to show up in index
% \rXXX is with a reference
% \rnXXX will typeset the title only the reference, but the reference shows up in the index
% \rnnXXX will typest only the title
\newcommand{\moatonidxcmd}[6]{
	\expandafter\newcommand\csname    #1\endcsname{#2\index{#5@#6}}
	\expandafter\newcommand\csname    #3\endcsname{#4\index{#5@#6}}
	\expandafter\newcommand\csname   r#1\endcsname[2]{#2 ##2\index{#5@#6!##1@\emph{##2}}}
	\expandafter\newcommand\csname  rn#1\endcsname[2]{##2\index{#5@#6!##1@\emph{##2}}}
	\expandafter\newcommand\csname rnn#1\endcsname[2]{#2\index{#5@#6!##1@\emph{##2}}}
	\expandafter\newcommand\csname   r#3\endcsname[2]{#4 ##2\index{#5@#6!##1@\emph{##2}}}
	\expandafter\newcommand\csname  rn#3\endcsname[2]{##2\index{#5@#6!##1@\emph{##2}}}
	\expandafter\newcommand\csname rnn#3\endcsname[2]{#4\index{#5@#6!##1@\emph{##2}}}
}

