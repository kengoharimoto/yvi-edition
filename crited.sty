% Hyphenation helper: TeX only hyphenates a word that begins right after
% glue, so a rule or parenthesis glued to a word (\mms, \mme, \mds, \mde)
% makes the whole adjoining word unbreakable.  A no-break zero glue on
% either side of the mark restores hyphenation without allowing a line
% break at the mark itself.
\newcommand{\hyphok}{\ifhmode\nobreak\hskip0pt\fi}
% A discretionary hyphen that leaves the words on both sides hyphenatable
% (a bare \- glued to a word switches off automatic hyphenation for it).
\newcommand{\hyb}{\hyphok\-\hyphok}

% Start of Tm missing.
\def\mms{%\hskip 1.1pt
  \hyphok
  \vrule width0.3pt height-.17ex depth.8ex
  \vrule width3pt height-.77ex depth.8ex 
  \vrule width-3.3pt
  \hyphok
%  \hskip .8pt
}

% End of Tm missing.
\def\mme{%\hskip 1.1pt
  \hyphok
  \vrule width-3.3pt
  \vrule width3pt height-.77ex depth.8ex
  \vrule width0.3pt height-.17ex depth.8ex
  \hyphok
%  \hskip .8pt
}
