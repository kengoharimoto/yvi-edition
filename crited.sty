\newcount\n
\def\lost#1{\n=0
  {\textrm [\enskip}%
  \loop\ifnum\n<#1 \advance\n by1
%  {\textrm .\enskip}\repeat{\textrm ]}}
  $\cdot$\enskip\repeat{\textrm ]}}

% Similarly, this is to be used for Devanagari transcripts.
\newcount\n
\def\mist#1{\enskip \n=0
  \loop\ifnum\n<#1 \advance\n by1
%  {\textrm .\enskip}\repeat}
  $\cdot$\enskip\repeat}

