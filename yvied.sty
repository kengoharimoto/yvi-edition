% Let us prepare a counter for the entire document
\newcounter{mycount}

% Insert pratikap{27_1}, etc., in the translation part
\newcommand{\pratikap}[1]{%
	% \thepage is not guarranteed to compute 
	\label{mylabel\themycount}%
	\ifthenelse{%
	  \isodd{%
	    \pageref{mylabel\themycount}%
	  }%
	} % then
	{\marginpar{\myraggedright{\hyperlink{hr#1}{\scriptsize{\pageref{#1},\lineref{#1}}}}}}%
	% else
	{\marginpar{\myraggedright{\hyperlink{hr#1}{\scriptsize{\hfill\pageref{#1},\lineref{#1}}}}}}%
	% endif
	\stepcounter{mycount}%
}

