	\ifthenelse{%
	  \isodd{\pageref{mylabel\themycount}}}{%
	  \marginpar{%
	    \myraggedright{%
	      \scriptsize{%
	        \pageref{nparanum\theeditionpar},%
			\lineref{paranum\theeditionpar}%
		  }%
		}%
	  }%
	}%
	{%
	  \marginpar{%
	    \myraggedright{%
		  \scriptsize{%
		    \hfill%
			\pageref{nparanum\theeditionpar},%
			\lineref{paranum\theeditionpar}%
		  }%
		}%
	  }%
	}%
	\stepcounter{mycount}%
	\stepcounter{editionpar}
}

% Just a simple pair of \label and \pageref does not produce a link to the page where the \label is but to the beginning of the section. Memoir correctly produces the page number to typeset but the link hyperref creates does not.
\newcommand{\labelh}[1]{\phantomsection\label{#1}}